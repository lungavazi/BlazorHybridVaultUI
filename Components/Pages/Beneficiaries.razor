@page "/beneficiaries"
@using VaultUI.Data.Dto
@inject IDialogService DialogService
@inject VaultService VaultService
@inject LoadingService Loader
@inject AuthService AuthService
@inject VaultUI.Services.SubscriptionLimitsService SubscriptionLimits
@inject MudBlazor.ISnackbar Snackbar

<div class="dashboard-scroll-container">
<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-4">
        <!-- Header Section -->
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
            <div>
                <MudText Typo="Typo.h5">Beneficiaries</MudText>
                @if (!AuthService.IsSubscribed)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">
                        Free Trial: @SubscriptionLimits.GetRemainingSlots("beneficiaries", BeneficiariesDto.Count) slot(s) remaining
                    </MudText>
                }
            </div>
            <MudSpacer />
            <MudIconButton Icon="fas fa-plus" 
                          Color="@(CanAddBeneficiary ? Color.Tertiary : Color.Default)"
                          Disabled="@(!CanAddBeneficiary)"
                          OnClick="AddBeneficiaryAsync"
                          Title="@(CanAddBeneficiary ? "Add Beneficiary" : SubscriptionLimits.GetUpgradeMessage("Beneficiaries"))" />
        </MudStack>

        <!-- Search Field -->
        <MudTextField @bind-Value="searchString"
                      Placeholder="Search All Beneficiaries..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      FullWidth="true"
                      @onkeydown="HandleKeyDownAsync" />

        <!-- Upgrade Prompt for Free Users -->
        @if (!AuthService.IsSubscribed && BeneficiariesDto.Count >= SubscriptionLimits.GetLimit("beneficiaries"))
        {
            <UpgradePrompt Title="Unlock Unlimited Beneficiaries" 
                          Message="You've added 1 beneficiary. Upgrade your subscription to add more beneficiaries and get full access to all features." />
        }

        <!-- Beneficiaries List -->
        <MudList T="BeneficiaryDto" Class="mt-3">
            @foreach (var beneficiary in BeneficiariesDto.Values)
            {
                <MudListItem Icon="@Icons.Material.Filled.People"
                            OnClick="@(() => EditBeneficiary(beneficiary))"
                            @ondblclick:stopPropagation
                            Class="@(AuthService.IsSubscribed ? "cursor-pointer" : "")">
                    
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="w-100">
                        <div style="flex: 1;">
                            <MudHighlighter Text="@beneficiary.Name"
                                           HighlightedText="@searchString" />
                            <MudText Typo="Typo.body2">
                                @beneficiary.Relationship
                            </MudText>
                        </div>

                        @if (AuthService.IsSubscribed)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.Settings"
                                    Color="Color.Tertiary"
                                    @onclick:stopPropagation="true">
                                <MudMenuItem Label="Edit"
                                            Icon="@Icons.Material.Filled.Edit"
                                            OnClick="@(() => EditBeneficiary(beneficiary))" />
                                <MudMenuItem Label="Remove"
                                            Icon="@Icons.Material.Filled.Delete"
                                            OnClick="@(() => DeleteBeneficiaryAsync(beneficiary.Id))" />
                            </MudMenu>
                        }
                        else
                        {
                            <MudChip Size="Size.Small" Color="Color.Warning">Limited</MudChip>
                        }
                    </MudStack>
                </MudListItem>
            }
        </MudList>

        <!-- Empty State -->
        @if (BeneficiariesDto.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                <MudText>No beneficiaries yet. Click the + button to add one.</MudText>
            </MudAlert>
        }
    </MudPaper>
</MudContainer>

<MudMessageBox @ref="_mudMessageBox" Title="Confirm Delete" CancelText="Cancel">
    <MessageContent>
        Are you sure you want to delete this beneficiary?
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever">Delete!</MudButton>
    </YesButton>
</MudMessageBox>
</div>

@code {
    private MudMessageBox? _mudMessageBox;
    string searchString = "";
    public Dictionary<long, BeneficiaryDto> BeneficiariesDto = new();

    /// <summary>
    /// Check if user can add more beneficiaries based on subscription status.
    /// </summary>
    private bool CanAddBeneficiary => SubscriptionLimits.CanAddMore("beneficiaries", BeneficiariesDto.Count);

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RefreshBenefeciaries();
        }
    }

    public async Task EditBeneficiary(BeneficiaryDto beneficiary)
    {
        // Only subscribed users can edit
        if (!AuthService.IsSubscribed)
        {
            Snackbar.Add("Upgrade your subscription to edit beneficiaries.", MudBlazor.Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["BeneficiaryEditDto"] = beneficiary
        };
        var options = new DialogOptions() 
        { 
            CloseButton = true, 
            FullWidth = true, 
            MaxWidth = MaxWidth.Small, 
            Position = DialogPosition.Center 
        };
        var dialog = await DialogService.ShowAsync<Beneficiary>("Edit Beneficiary", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (result.Data is BeneficiaryDto data && data != null)
            {
                BeneficiariesDto[data.Id] = data;
            }
        }
    }

    public async Task DeleteBeneficiaryAsync(long id)
    {
        bool? result = await _mudMessageBox?.ShowAsync()!;
        if (result is not null && result == true)
        {
            await VaultService.DeleteBeneficiaryAsync(id);
            BeneficiariesDto.Remove(id);
            Snackbar.Add("Beneficiary deleted.", MudBlazor.Severity.Success);
        }
    }

    public async Task AddBeneficiaryAsync()
    {
        // Check if user can add more beneficiaries
        if (!CanAddBeneficiary)
        {
            Snackbar.Add(SubscriptionLimits.GetUpgradeMessage("Beneficiaries"), MudBlazor.Severity.Warning);
            return;
        }

        var options = new DialogOptions() 
        { 
            CloseButton = true, 
            FullWidth = true, 
            MaxWidth = MaxWidth.Small, 
            Position = DialogPosition.Center 
        };
        var dialog = await DialogService.ShowAsync<Beneficiary>("Add Beneficiary", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (result.Data is BeneficiaryDto data && data != null)
            {
                BeneficiariesDto.Add(data.Id, data);
                Snackbar.Add("Beneficiary added successfully.", MudBlazor.Severity.Success);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Loader.IsLoading = true;
            await RefreshBenefeciaries();
            Loader.IsLoading = false;
        }
        catch (Exception ex)
        {
            Loader.IsLoading = false;
            Snackbar.Add($"Error loading beneficiaries: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task RefreshBenefeciaries()
    {
        var beneficiaries = await VaultService.GetBeneficiariesAsync(AuthService.Email ?? string.Empty, searchString);
        BeneficiariesDto = beneficiaries.ToDictionary(b => b.Id);
    }
}