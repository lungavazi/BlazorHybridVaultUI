@page "/policies"
@using VaultUI.Data.Dto
@inject IDialogService DialogService
@inject LoadingService Loader
@inject VaultService VaultService
@inject AuthService AuthService
@inject VaultUI.Services.SubscriptionLimitsService SubscriptionLimits
@inject MudBlazor.ISnackbar Snackbar

<div class="dashboard-scroll-container">
<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-4">
        <!-- Header Section -->
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
            <div>
                <MudText Typo="Typo.h5">Insurance Policies</MudText>
                @if (!AuthService.IsSubscribed)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">
                        Free Trial: @SubscriptionLimits.GetRemainingSlots("policies", PoliciesDto.Count) slot(s) remaining
                    </MudText>
                }
            </div>
            <MudSpacer />
            <MudIconButton Icon="fas fa-plus"
                          Color="@(CanAddPolicy ? Color.Tertiary : Color.Default)"
                          Disabled="@(!CanAddPolicy)"
                          OnClick="AddPolicyAsync"
                          Title="@(CanAddPolicy ? "Add Policy" : SubscriptionLimits.GetUpgradeMessage("Policies"))" />
        </MudStack>

        <!-- Search Field -->
        <MudTextField @bind-Value="searchString"
                      Placeholder="Search All Insurance Policies"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      FullWidth="true"
                      @onkeydown="HandleKeyDownAsync" />

        <!-- Upgrade Prompt for Free Users -->
        @if (!AuthService.IsSubscribed && PoliciesDto.Count >= SubscriptionLimits.GetLimit("policies"))
        {
            <UpgradePrompt Title="Unlock Unlimited Policies"
                          Message="You've added 1 policy. Upgrade your subscription to add more policies and get full access to all features." />
        }

        <!-- Policies List -->
        <MudList T="string" Class="mt-3">
            @foreach (var policy in PoliciesDto.Values)
            {
                <MudListItem Icon="@Icons.Material.Filled.Policy"
                            OnClick="@(() => EditPolicy(policy))"
                            @ondblclick:stopPropagation
                            Class="@(AuthService.IsSubscribed ? "cursor-pointer" : "")">
                    
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="w-100">
                        <div style="flex: 1;">
                            <MudHighlighter Text="@policy.Name"
                                           HighlightedText="@searchString" />
                            <MudText Typo="Typo.body2">
                                @policy.InsuranceType
                            </MudText>
                        </div>

                        @if (AuthService.IsSubscribed)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.Settings"
                                    Color="Color.Tertiary"
                                    @onclick:stopPropagation="true">
                                <MudMenuItem Label="Edit"
                                            Icon="@Icons.Material.Filled.Edit"
                                            OnClick="@(() => EditPolicy(policy))" />
                                <MudMenuItem Label="Remove"
                                            Icon="@Icons.Material.Filled.Delete"
                                            OnClick="@(() => DeleteInsuranceAsync(policy.Id))" />
                            </MudMenu>
                        }
                        else
                        {
                            <MudChip Size="Size.Small" Color="Color.Warning">Limited</MudChip>
                        }
                    </MudStack>
                </MudListItem>
            }
        </MudList>

        <!-- Empty State -->
        @if (PoliciesDto.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                <MudText>No policies yet. Click the + button to add one.</MudText>
            </MudAlert>
        }
    </MudPaper>
</MudContainer>

<MudMessageBox @ref="_mudMessageBox" Title="Confirm Delete" CancelText="Cancel">
    <MessageContent>
        Are you sure you want to delete this policy?
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever">Delete!</MudButton>
    </YesButton>
</MudMessageBox>
</div>

@code {
    private MudMessageBox? _mudMessageBox;
    string searchString = "";
    public Dictionary<long, PolicyDto> PoliciesDto = new();

    /// <summary>
    /// Check if user can add more policies based on subscription status.
    /// </summary>
    private bool CanAddPolicy => SubscriptionLimits.CanAddMore("policies", PoliciesDto.Count);

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RefreshPolicies();
        }
    }

    public async Task EditPolicy(PolicyDto policy)
    {
        // Only subscribed users can edit
        if (!AuthService.IsSubscribed)
        {
            Snackbar.Add("Upgrade your subscription to edit policies.", MudBlazor.Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["PolicyEditDto"] = policy,
        };

        var options = new DialogOptions() 
        { 
            CloseButton = true, 
            FullWidth = true, 
            MaxWidth = MaxWidth.Small, 
            Position = DialogPosition.Center 
        };
        var dialog = await DialogService.ShowAsync<Policy>("Edit Policy", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (result.Data is PolicyDto data)
            {
                PoliciesDto[data.Id] = data;
                Snackbar.Add("Policy updated successfully.", MudBlazor.Severity.Success);
            }
        }
    }

    public async Task DeleteInsuranceAsync(long id)
    {
        bool? result = await _mudMessageBox?.ShowAsync()!;
        if (result is not null && result == true)
        {
            await VaultService.DeleteInsuranceAsync(id);
            PoliciesDto.Remove(id);
            Snackbar.Add("Policy deleted.", MudBlazor.Severity.Success);
        }
    }

    public async Task AddPolicyAsync()
    {
        // Check if user can add more policies
        if (!CanAddPolicy)
        {
            Snackbar.Add(SubscriptionLimits.GetUpgradeMessage("Policies"), MudBlazor.Severity.Warning);
            return;
        }

        var options = new DialogOptions() 
        { 
            CloseButton = true, 
            FullWidth = true, 
            MaxWidth = MaxWidth.Small, 
            Position = DialogPosition.Center 
        };
        var dialog = await DialogService.ShowAsync<Policy>("Add Policy", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (result.Data is PolicyDto data)
            {
                PoliciesDto.Add(data.Id, data);
                Snackbar.Add("Policy added successfully.", MudBlazor.Severity.Success);
            }
        }
    }

    // public Dictionary<long, PolicyDto> PoliciesDto = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Loader.IsLoading = true;
            await RefreshPolicies();
            Loader.IsLoading = false;
        }
        catch (Exception ex)
        {
            Loader.IsLoading = false;
            Snackbar.Add($"Error loading policies: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task RefreshPolicies()
    {
        var policies = await VaultService.GetPoliciesAsync(AuthService.Email ?? string.Empty, searchString);
        PoliciesDto = policies.ToDictionary(p => p.Id);
    }
}
