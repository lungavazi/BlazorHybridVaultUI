@page "/accounts"
@inject IDialogService DialogService
@inject VaultService VaultService
@inject LoadingService Loader
@inject AuthService AuthService
@inject VaultUI.Services.SubscriptionLimitsService SubscriptionLimits
@inject MudBlazor.ISnackbar Snackbar

<div class="dashboard-scroll-container">
<MudContainer MaxWidth="MaxWidth.Medium">
    <MudPaper Class="pa-4">
        <!-- Header Section -->
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-3">
            <div>
                <MudText Typo="Typo.h5">Accounts</MudText>
                @if (!AuthService.IsSubscribed)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">
                        Free Trial: @SubscriptionLimits.GetRemainingSlots("accounts", AccountsDto.Count) slot(s) remaining
                    </MudText>
                }
            </div>
            <MudSpacer />
            <MudIconButton Icon="fas fa-plus" 
                          Color="@(CanAddAccount ? Color.Tertiary : Color.Default)"
                          Disabled="@(!CanAddAccount)"
                          OnClick="AddAccountAsync"
                          Title="@(CanAddAccount ? "Add Account" : SubscriptionLimits.GetUpgradeMessage("Accounts"))" />
        </MudStack>

        <!-- Search Field -->
        <MudTextField @bind-Value="searchString"
                      Placeholder="Search All Accounts"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium"
                      FullWidth="true"
                      @onkeydown="HandleKeyDown" />

        <!-- Upgrade Prompt for Free Users -->
        @if (!AuthService.IsSubscribed && AccountsDto.Count >= SubscriptionLimits.GetLimit("accounts"))
        {
            <UpgradePrompt Title="Unlock Unlimited Accounts"
                          Message="You've added 1 account. Upgrade your subscription to add more accounts and get full access to all features." />
        }

        <!-- Accounts List -->
        <MudList T="string" Class="mt-3">
            @foreach (var account in AccountsDto.Values)
            {
                <MudListItem Icon="@Icons.Material.Filled.AccountBalance"
                            OnClick="@(() => EditAccount(account))"
                            @ondblclick:stopPropagation
                            Class="@(AuthService.IsSubscribed ? "cursor-pointer" : "")">
                    
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="w-100">
                        <div style="flex: 1;">
                            <MudHighlighter Text="@account.Name"
                                           HighlightedText="@searchString" />
                            <MudText Typo="Typo.body2">
                                @account.AccountType
                            </MudText>
                        </div>

                        @if (AuthService.IsSubscribed)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.Settings"
                                    Color="Color.Tertiary"
                                    @onclick:stopPropagation="true">
                                <MudMenuItem Label="Edit"
                                            Icon="@Icons.Material.Filled.Edit"
                                            OnClick="@(() => EditAccount(account))" />
                                <MudMenuItem Label="Remove"
                                            Icon="@Icons.Material.Filled.Delete"
                                            OnClick="@(() => DeleteAccountAsync(account.Id))" />
                            </MudMenu>
                        }
                        else
                        {
                            <MudChip Size="Size.Small" Color="Color.Warning">Limited</MudChip>
                        }
                    </MudStack>
                </MudListItem>
            }
        </MudList>

        <!-- Empty State -->
        @if (AccountsDto.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                <MudText>No accounts yet. Click the + button to add one.</MudText>
            </MudAlert>
        }
    </MudPaper>
</MudContainer>

<MudMessageBox @ref="_mudMessageBox" Title="Confirm Delete" CancelText="Cancel">
    <MessageContent>
        Are you sure you want to delete this account?
    </MessageContent>
    <YesButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.DeleteForever">Delete!</MudButton>
    </YesButton>
</MudMessageBox>
</div>

@code {
    private MudMessageBox? _mudMessageBox;
    string searchString = "";
    private Dictionary<long, AccountDto> AccountsDto = new();

    /// <summary>
    /// Check if user can add more accounts based on subscription status.
    /// </summary>
    private bool CanAddAccount => SubscriptionLimits.CanAddMore("accounts", AccountsDto.Count);

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await RefreshAccounts();
        }
    }

    public async Task EditAccount(AccountDto account)
    {
        // Only subscribed users can edit
        if (!AuthService.IsSubscribed)
        {
            Snackbar.Add("Upgrade your subscription to edit accounts.", MudBlazor.Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["AccountEditDto"] = account
        };

        var options = new DialogOptions() 
        { 
            CloseButton = true, 
            FullWidth = true, 
            MaxWidth = MaxWidth.Small, 
            Position = DialogPosition.Center 
        };
        var dialog = await DialogService.ShowAsync<Account>("Edit Account", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (result.Data is AccountDto data && data != null)
            {
                AccountsDto[data.Id] = data;
                Snackbar.Add("Account updated successfully.", MudBlazor.Severity.Success);
            }
        }
    }

    public async Task DeleteAccountAsync(long Id)
    {
        bool? result = await _mudMessageBox?.ShowAsync()!;
        if (result is not null && result == true)
        {
            await VaultService.DeleteAccountAsync(Id);
            AccountsDto.Remove(Id);
            Snackbar.Add("Account deleted.", MudBlazor.Severity.Success);
        }
    }

    public async Task AddAccountAsync()
    {
        // Check if user can add more accounts
        if (!CanAddAccount)
        {
            Snackbar.Add(SubscriptionLimits.GetUpgradeMessage("Accounts"), MudBlazor.Severity.Warning);
            return;
        }

        var options = new DialogOptions() 
        { 
            CloseButton = true, 
            FullWidth = true, 
            MaxWidth = MaxWidth.Small, 
            Position = DialogPosition.Center 
        };
        var dialog = await DialogService.ShowAsync<Account>("Add Account", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (result.Data is AccountDto data && data != null)
            {
                AccountsDto.Add(data.Id, data);
                Snackbar.Add("Account added successfully.", MudBlazor.Severity.Success);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Loader.IsLoading = true;
            await RefreshAccounts();
            Loader.IsLoading = false;
        }
        catch (Exception ex)
        {
            Loader.IsLoading = false;
            Snackbar.Add($"Error loading accounts: {ex.Message}", MudBlazor.Severity.Error);
        }
    }

    private async Task RefreshAccounts()
    {
        var accounts = await VaultService.GetAccoutsAsync(AuthService.Email ?? string.Empty, searchString);
        AccountsDto = accounts.ToDictionary(a => a.Id);
    }
}
