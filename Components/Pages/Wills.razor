@page "/wills"
@inject LoadingService Loader
@inject AuthService AuthService
@inject VaultService VaultService
@inject ISnackbar Snackbar

<div class="dashboard-scroll-container">
    <MudContainer MaxWidth="MaxWidth.Medium">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h5" Class="mb-2">Will — Institution & Contact</MudText>

            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-3" Elevation="0">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Institution</MudText>

                        <MudTextField @bind-Value="InstitutionName" Label="Institution name" FullWidth="true" />
                        <MudTextField @bind-Value="InstitutionAddress" Label="Institution address" Lines="3" TextArea="true" FullWidth="true" Class="mt-2" />

                        <MudDivider Class="my-3" />

                        <MudText Typo="Typo.subtitle1" Class="mb-2">Contact person</MudText>

                        <MudTextField @bind-Value="ContactName" Label="Full name" FullWidth="true" />
                        <MudTextField @bind-Value="ContactRole" Label="Role / Relationship" FullWidth="true" Class="mt-2" />
                        <MudTextField @bind-Value="ContactPhone" Label="Phone" Adornment="Adornment.Start" AdornmentText="+"
                                      FullWidth="true" Class="mt-2" />
                        <MudTextField @bind-Value="ContactEmail" Label="Email" FullWidth="true" Class="mt-2" />

                        <MudTextField @bind-Value="Notes" Label="Notes" Lines="6" TextArea="true" FullWidth="true" Class="mt-3" />

                        <div class="mt-3 d-flex">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveWillAsync" Disabled="isProcessing">
                                @(isProcessing ? "Saving..." : "Save")
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Class="ml-2" OnClick="ClearForm" Disabled="isProcessing">Clear</MudButton>
                        </div>

                        @if (!string.IsNullOrEmpty(ErrorMessage))
                        {
                            <MudText Color="Color.Error" Class="mt-2">@ErrorMessage</MudText>
                        }
                        @if (!string.IsNullOrEmpty(SuccessMessage))
                        {
                            <MudText Color="Color.Success" Class="mt-2">@SuccessMessage</MudText>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-3" Elevation="0">
                        <MudText Typo="Typo.subtitle1" Class="mb-2">Saved will preview</MudText>

                        @if (HasSavedWill)
                        {
                            <MudList T="string" Dense="true">
                                <MudListItem>
                                    <MudText><b>Institution:</b> @InstitutionName</MudText>
                                </MudListItem>
                                <MudListItem>
                                    <MudText><b>Address:</b> @InstitutionAddress</MudText>
                                </MudListItem>
                                <MudListItem>
                                    <MudText><b>Contact:</b> @ContactName (@ContactRole)</MudText>
                                </MudListItem>
                                <MudListItem>
                                    <MudText><b>Phone:</b> @ContactPhone</MudText>
                                </MudListItem>
                                <MudListItem>
                                    <MudText><b>Email:</b> @ContactEmail</MudText>
                                </MudListItem>
                                <MudListItem>
                                    <MudText><b>Notes:</b></MudText>
                                </MudListItem>
                                <MudListItem>
                                    <MudText Typo="Typo.body2">@Notes</MudText>
                                </MudListItem>
                            </MudList>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No saved will details yet.</MudText>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudContainer>
</div>

@code {
    bool isProcessing = false;
    bool HasSavedWill = false;

    string InstitutionName { get; set; } = string.Empty;
    string InstitutionAddress { get; set; } = string.Empty;

    string ContactName { get; set; } = string.Empty;
    string ContactRole { get; set; } = string.Empty;
    string ContactPhone { get; set; } = string.Empty;
    string ContactEmail { get; set; } = string.Empty;
    long WillId { get; set; } = 0;

    string Notes { get; set; } = string.Empty;

    string ErrorMessage { get; set; } = string.Empty;
    string SuccessMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Loader.OnChange += StateHasChanged;
        await LoadSavedWillAsync();
    }

    async Task LoadSavedWillAsync()
    {
        try
        {
            Loader.IsLoading = true;
            var will = await VaultService.GetWillAsync(AuthService.Email ?? string.Empty);
            if (will != null)
            {
                WillId = will.Id;
                InstitutionName = will.InstitutionName ?? string.Empty;
                InstitutionAddress = will.InstitutionAddress ?? string.Empty;

                ContactName = will.ContactName ?? string.Empty;
                ContactRole = will.ContactRole ?? string.Empty;
                ContactPhone = will.ContactPhone ?? string.Empty;
                ContactEmail = will.ContactEmail ?? string.Empty;

                Notes = will.Notes ?? string.Empty;
                HasSavedWill = true;
            }
        }
        finally
        {
            Loader.IsLoading = false;
            StateHasChanged();
        }
    }

    void ClearForm()
    {
        InstitutionName = string.Empty;
        InstitutionAddress = string.Empty;
        ContactName = string.Empty;
        ContactRole = string.Empty;
        ContactPhone = string.Empty;
        ContactEmail = string.Empty;
        Notes = string.Empty;
        ErrorMessage = SuccessMessage = string.Empty;
        HasSavedWill = false;
    }

    async Task SaveWillAsync()
    {
        ErrorMessage = SuccessMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(AuthService.Email))
        {
            Snackbar.Add("User not available.", Severity.Error);
            return;
        }

        isProcessing = true;
        Loader.IsLoading = true;

        var payload = new WillCreateRequestDto
        {
            Username = AuthService.Email,
            InstitutionName = InstitutionName,
            InstitutionAddress = InstitutionAddress,
            ContactName = ContactName,
            ContactRole = ContactRole,
            ContactPhone = ContactPhone,
            ContactEmail = ContactEmail,
            Notes = Notes,
            Id = WillId
        };

        try
        {
            var id = await VaultService.CreateUpdateWill(payload);
            HasSavedWill = true;
            Snackbar.Add("Will saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add("Error occurred while saving will.", Severity.Error);
        }
        finally
        {
            isProcessing = false;
            Loader.IsLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Loader.OnChange -= StateHasChanged;
    } 
   }